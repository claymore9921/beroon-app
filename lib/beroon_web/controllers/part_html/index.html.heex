<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <section class="mx-auto min-h-screen w-full max-w-2xl bg-stone-50 px-4 pb-24 pt-5">
    <div class="flex items-center justify-between gap-3">
      <div>
        <h1 class="text-2xl font-black">قطعات</h1>
        <p class="mt-1 text-sm text-zinc-500">موجودی انبار قطعات تعمیرگاه</p>
      </div>
      <button type="button" class="btn btn-primary gap-1" onclick="document.getElementById('add-part-dialog').showModal()">
        <.icon name="hero-plus" class="size-5" />افزودن قطعه
      </button>
    </div>

    <section class="mt-5 grid gap-2">
      <p :if={@parts == []} class="rounded-lg border border-zinc-200 bg-white p-4 text-sm text-zinc-500">
        هنوز قطعه‌ای ثبت نشده است.
      </p>

      <article :for={part <- @parts} class="flex items-center justify-between gap-3 rounded-xl border border-zinc-200 bg-white p-4 shadow-sm">
        <div>
          <p class="font-black text-zinc-950">{part.name}</p>
          <p class="mt-1 text-sm text-zinc-500">موجودی: {part.quantity}</p>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            class="btn btn-sm gap-1"
            onclick={"document.getElementById('edit-part-dialog-#{part.id}').showModal()"}
          >
            <.icon name="hero-pencil-square" class="size-4" />ویرایش
          </button>
          <.link
            href={~p"/admin/parts/#{part.id}"}
            method="delete"
            data-confirm="آیا از حذف این قطعه مطمئن هستید؟"
            class="btn btn-sm btn-error btn-outline"
          >
            حذف
          </.link>
        </div>
      </article>
    </section>
  </section>

  <dialog id="add-part-dialog" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box w-[92vw] m-auto max-w-sm rounded-2xl bg-white p-5 shadow-2xl">
      <div class="flex items-start justify-between gap-3">
        <h2 class="text-lg font-black text-zinc-950">افزودن قطعه جدید</h2>
        <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('add-part-dialog').close()">بستن</button>
      </div>

      <.form :let={f} for={@form} action={~p"/admin/parts"} class="mt-4 grid gap-3">
        <.input field={f[:name]} type="text" label="نام قطعه" class="input input-bordered w-full" required />
        <.input field={f[:quantity]} type="number" label="تعداد موجودی" min="0" value={0} class="input input-bordered w-full" required />
        <.button class="btn btn-primary mt-2 min-h-11 w-full">ثبت قطعه</.button>
      </.form>
    </div>
    <form method="dialog" class="modal-backdrop"><button aria-label="بستن"></button></form>
  </dialog>

  <dialog :for={part <- @parts} id={"edit-part-dialog-#{part.id}"} class="modal modal-bottom sm:modal-middle">
    <div class="modal-box w-[92vw] m-auto max-w-sm rounded-2xl bg-white p-5 shadow-2xl">
      <div class="flex items-start justify-between gap-3">
        <h2 class="text-lg font-black text-zinc-950">ویرایش «{part.name}»</h2>
        <button type="button" class="btn btn-ghost btn-sm" onclick={"document.getElementById('edit-part-dialog-#{part.id}').close()"}>بستن</button>
      </div>

      <form method="post" action={~p"/admin/parts/#{part.id}"} class="mt-4 grid gap-3">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <input type="hidden" name="_method" value="put" />
        <label class="form-control">
          <span class="label-text mb-1 font-bold">نام قطعه</span>
          <input type="text" name="part[name]" value={part.name} class="input input-bordered w-full" required />
        </label>
        <label class="form-control">
          <span class="label-text mb-1 font-bold">تعداد موجودی</span>
          <input type="number" name="part[quantity]" value={part.quantity} min="0" class="input input-bordered w-full" required />
        </label>
        <button class="btn btn-primary mt-2 min-h-11 w-full">ذخیره</button>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button aria-label="بستن"></button></form>
  </dialog>
</main>
