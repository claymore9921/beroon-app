<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <section class="mx-auto min-h-screen w-full max-w-4xl bg-stone-50 px-4 pb-24 pt-5">
    <div class="flex items-center justify-between gap-3">
      <div>
        <h1 class="text-2xl font-black">شام شب</h1>
        <p class="mt-1 text-sm text-zinc-500">تعداد و اسامی متصدیان شام هر شعبه در تاریخ انتخابی</p>
      </div>
      <div class="flex items-center gap-3">
        <.link navigate={~p"/admin/dinner/settings"} class="btn btn-sm gap-1">
          <.icon name="hero-cog-6-tooth" class="size-4" />روزهای مجاز هر شعبه
        </.link>
        <.icon name="hero-cake" class="size-9 text-orange-600" />
      </div>
    </div>

    <form
      id="admin-dinner-filter"
      method="get"
      action={~p"/admin/dinner"}
      class="mt-4 grid grid-cols-[1fr_auto] items-end gap-2 rounded-xl border border-zinc-200 bg-white p-4 shadow-sm"
    >
      <label class="form-control min-w-0">
        <span class="label-text mb-2 font-bold">تاریخ شمسی</span>
        <input
          type="text"
          name="date"
          value={Beroon.Calendar.persian_numeric_date(@selected_date)}
          placeholder="مثال: ۱۴۰۵/۰۵/۰۱"
          class="input input-bordered min-h-11 w-full"
        />
      </label>
      <button class="btn btn-neutral min-h-11">نمایش</button>
    </form>

    <section class="mt-4 grid gap-3 md:grid-cols-2">
      <p :if={@dinner_reports == []} class="rounded-lg border border-zinc-200 bg-white p-4 text-sm text-zinc-500">
        هنوز شعبه‌ای ثبت نشده است.
      </p>
      <article :for={report <- @dinner_reports} class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm">
        <div class="flex items-center justify-between gap-3">
          <p class="font-black text-zinc-950">{report.branch_name}</p>
          <div class="flex items-center gap-2">
            <span class={[
              "rounded-full px-3 py-1 text-xs font-black",
              if(report.submitted, do: "bg-emerald-100 text-emerald-800", else: "bg-zinc-100 text-zinc-500")
            ]}>
              {if report.submitted, do: "#{report.attendant_count} نفر", else: "ثبت نشده"}
            </span>
            <.link
              navigate={~p"/admin/dinner/branches/#{report.branch_id}/edit?date=#{Beroon.Calendar.persian_numeric_date(@selected_date)}"}
              class="btn btn-xs"
            >
              ویرایش
            </.link>
          </div>
        </div>

        <div :if={report.submitted && report.attendant_names != []} class="mt-3 grid gap-1.5">
          <p :for={{name, index} <- Enum.with_index(report.attendant_names, 1)} class="rounded-lg bg-zinc-50 px-3 py-2 text-sm">
            <span class="ml-1 font-black text-zinc-400">{index}.</span>{name}
          </p>
        </div>

        <p :if={report.submitted && report.attendant_names == []} class="mt-3 text-sm text-zinc-500">
          نامی ثبت نشده است.
        </p>
      </article>
    </section>
  </section>
</main>
