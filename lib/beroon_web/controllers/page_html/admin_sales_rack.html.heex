<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <section class="mx-auto min-h-screen w-full max-w-5xl bg-stone-50 px-4 pb-20 pt-5">
    <section class="mt-5 rounded-xl border border-zinc-200 bg-white p-4">
      <h2 class="text-lg font-black">موجودی رگال فروش هر شعبه</h2>
      <p class="mt-1 text-sm text-zinc-500">برای هر نوع دستگاه، تعداد موجود در رگال فروش هر شعبه را وارد کنید.</p>

      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-right">
          <thead>
            <tr class="border-b border-zinc-200 text-xs font-bold text-zinc-500">
              <th class="px-3 py-2">نوع دستگاه</th>
              <th :for={branch <- @branches} class="px-3 py-2">{branch.name}</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={type <- @stocks} class="border-b border-zinc-100">
              <td class="px-3 py-3 font-black">{device_type_label(type)}</td>
              <td :for={branch <- @branches} class="px-3 py-3">
                <% stock = Enum.find(type.sales_rack_stocks, &(&1.branch_id == branch.id)) %>
                <form method="post" action={~p"/admin/sales-rack/stocks"} class="flex items-center gap-1">
                  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                  <input type="hidden" name="stock[device_type_id]" value={type.id} />
                  <input type="hidden" name="stock[branch_id]" value={branch.id} />
                  <input type="number" min="0" name="stock[quantity]" value={if stock, do: stock.quantity, else: 0} class="input input-bordered input-sm w-20" />
                  <button class="btn btn-sm btn-neutral">ذخیره</button>
                </form>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </section>
</main>
