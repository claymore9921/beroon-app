<Layouts.flash_group flash={@flash} />
<.reporter_layout active="daily">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black text-[#12283b]">گزارش روزانه</h1>
      <p class="mt-1 text-sm font-medium text-[#6b7280]">تاریخ: {Beroon.Calendar.persian_date(@report_date)}</p>
    </div>
    <div class="flex items-center gap-3">
      <form method="get" class="flex items-center gap-2">
        <input
          type="text"
          name="date"
          value={Beroon.Calendar.persian_numeric_date(@report_date)}
          placeholder="۱۴۰۵/۰۵/۰۱"
          class="w-36 rounded-lg border border-[#dcd4bf] bg-white px-3 py-2 text-sm font-semibold text-[#12283b] focus:border-[#c9a24b] focus:outline-none"
        />
        <button class="rounded-lg bg-[#12283b] px-4 py-2 text-sm font-black text-white hover:bg-[#0f2942]">نمایش</button>
      </form>
      <.reporter_export_buttons export_json={@export_json} download_url={~p"/reports/daily/download?date=#{Beroon.Calendar.persian_numeric_date(@report_date)}"} />
    </div>
  </div>

  <section class="mt-6 overflow-x-auto rounded-2xl border border-[#e4ddcd] bg-white shadow-sm">
    <table class="w-full text-right">
      <thead>
        <tr class="border-b border-[#eee7d8] text-xs font-semibold text-[#8a8171]">
          <th class="px-6 py-3">شعبه</th>
          <th class="px-6 py-3">وضعیت ثبت</th>
          <th class="px-6 py-3">اسکن‌شده</th>
          <th class="px-6 py-3">تعمیرگاه</th>
          <th class="px-6 py-3">در انتظار قطعه</th>
          <th class="px-6 py-3">امانی</th>
          <th class="px-6 py-3">سرقتی</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={row <- @rows} class="border-b border-[#f3efe3] last:border-0 hover:bg-[#faf8f2]">
          <td class="px-6 py-4 font-black text-[#12283b]">{row.branch_name}</td>
          <td class="px-6 py-4">
            <span class={[
              "rounded-full px-3 py-1 text-xs font-black",
              if(row.submitted, do: "bg-[#eaf3ec] text-[#2f7a4f]", else: "bg-[#faeaea] text-[#a5423a]")
            ]}>
              {if row.submitted, do: "ثبت شده", else: "ثبت نشده"}
            </span>
          </td>
          <td class="px-6 py-4 font-black text-[#12283b]">{row.scanned_count}</td>
          <td class="px-6 py-4 font-black text-[#12283b]">{row.workshop_count}</td>
          <td class="px-6 py-4 font-black text-[#12283b]">{row.waiting_for_part_count}</td>
          <td class="px-6 py-4 font-black text-[#12283b]">{row.loaned_count}</td>
          <td class="px-6 py-4 font-black text-[#12283b]">{row.stolen_count}</td>
        </tr>
        <tr :if={@rows == []}>
          <td colspan="7" class="px-6 py-10 text-center text-sm text-[#8a8171]">شعبه‌ی فعالی ثبت نشده است.</td>
        </tr>
      </tbody>
    </table>
  </section>
</.reporter_layout>
