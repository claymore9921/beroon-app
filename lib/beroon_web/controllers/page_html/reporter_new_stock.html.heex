<Layouts.flash_group flash={@flash} />
<.reporter_layout active="new_stock">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black text-[#12283b]">انبار نو</h1>
      <p class="mt-1 text-sm font-medium text-[#6b7280]">موجودی لحظه‌ای انبار نو — {Beroon.Calendar.persian_date(@report_date)}</p>
    </div>
    <div class="flex items-center gap-3">
      <form method="get" class="flex items-center gap-2">
        <input
          type="text"
          name="date"
          value={Beroon.Calendar.persian_numeric_date(@report_date)}
          placeholder="۱۴۰۵/۰۵/۰۱"
          class="w-36 rounded-lg border border-[#dcd4bf] bg-white px-3 py-2 text-sm font-semibold text-[#12283b] focus:border-[#c9a24b] focus:outline-none"
        />
        <button class="rounded-lg bg-[#12283b] px-4 py-2 text-sm font-black text-white hover:bg-[#0f2942]">نمایش</button>
      </form>
      <.reporter_export_buttons export_json={@export_json} download_url={~p"/reports/new-stock/download?date=#{Beroon.Calendar.persian_numeric_date(@report_date)}"} />
    </div>
  </div>

  <p class="mt-2 text-xs font-medium text-[#a89b7d]">این موجودی لحظه‌ای انبار است و تاریخچه‌ی روزانه ندارد؛ تاریخ فقط برای برچسب‌گذاری گزارش است.</p>

  <section class="mt-4 overflow-x-auto rounded-2xl border border-[#e4ddcd] bg-white shadow-sm">
    <table class="w-full text-right">
      <thead>
        <tr class="border-b border-[#eee7d8] text-xs font-semibold text-[#8a8171]">
          <th class="px-6 py-3">نوع دستگاه</th>
          <th class="px-6 py-3">موجودی</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={type <- @stocks} class="border-b border-[#f3efe3] last:border-0 hover:bg-[#faf8f2]">
          <td class="px-6 py-4 font-black text-[#12283b]">{device_type_label(type)}</td>
          <td class="px-6 py-4 font-black text-[#12283b]">{if type.new_device_stock, do: type.new_device_stock.quantity, else: 0}</td>
        </tr>
        <tr :if={@stocks == []}>
          <td colspan="2" class="px-6 py-10 text-center text-sm text-[#8a8171]">نوع دستگاهی ثبت نشده است.</td>
        </tr>
      </tbody>
    </table>
  </section>
</.reporter_layout>
