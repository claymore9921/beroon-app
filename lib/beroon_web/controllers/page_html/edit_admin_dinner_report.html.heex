<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <section class="mx-auto min-h-screen w-full max-w-md bg-stone-50 px-4 pb-24 pt-5">
    <.link navigate={~p"/admin/dinner?date=#{Beroon.Calendar.persian_numeric_date(@selected_date)}"} class="text-sm font-bold text-orange-700">
      بازگشت
    </.link>
    <div class="mt-2 flex items-center justify-between gap-3">
      <div>
        <h1 class="text-2xl font-black">ویرایش آمار شام</h1>
        <p class="mt-1 text-sm font-bold text-zinc-500">{@branch.name} · {Beroon.Calendar.persian_date(@selected_date)}</p>
      </div>
      <.icon name="hero-cake" class="size-9 text-orange-600" />
    </div>

    <p class="mt-3 rounded-lg border border-sky-200 bg-sky-50 p-3 text-xs font-bold text-sky-800">
      به‌عنوان ادمین، این ویرایش بدون توجه به روزهای مجاز یا ثبت قبلی شعبه اعمال می‌شود.
    </p>

    <.form
      :let={f}
      for={%{}}
      as={:dinner}
      action={~p"/admin/dinner/branches/#{@branch.id}/edit?date=#{Beroon.Calendar.persian_numeric_date(@selected_date)}"}
      id="dinner-form"
      data-initial-names={Jason.encode!(@dinner_report && @dinner_report.attendant_names || [])}
      class="mt-4 rounded-xl border border-zinc-200 bg-white p-5"
    >
      <label class="block">
        <span class="mb-2 block text-sm font-semibold">تعداد متصدیان</span>
        <input
          id="dinner-count"
          type="number"
          min="0"
          max="40"
          step="1"
          inputmode="numeric"
          value={@dinner_report && @dinner_report.attendant_count || 0}
          class="input input-bordered min-h-12 w-full"
        />
      </label>

      <div id="dinner-names-container" class="mt-4 grid gap-3"></div>

      <.button id="submit-dinner" class="btn btn-primary mt-5 min-h-14 w-full">ذخیره آمار شام</.button>
    </.form>
  </section>
</main>
