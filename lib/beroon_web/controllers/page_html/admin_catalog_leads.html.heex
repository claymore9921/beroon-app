<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <section class="mx-auto min-h-screen w-full max-w-3xl bg-stone-50 px-4 pb-20 pt-6">
    <header class="flex items-center justify-between border-b border-zinc-200 pb-4">
      <div><p class="text-sm font-bold text-orange-700">کاتالوگ فروش</p><h1 class="text-2xl font-black">مخاطبان کاتالوگ</h1></div>
      <.link navigate={~p"/admin/reports"} class="btn btn-sm">بازگشت</.link>
    </header>
    <div class="mt-5 grid gap-3">
      <div :if={@leads == []} class="rounded-2xl bg-white p-6 text-center text-zinc-500">هنوز مشخصاتی ثبت نشده است.</div>
      <article :for={lead <- @leads} class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm">
        <div class="flex items-start justify-between gap-3">
          <div><h2 class="font-black text-zinc-900">{lead.name}</h2><a href={"tel:#{lead.phone}"} class="mt-1 block font-bold text-teal-700" dir="ltr">{lead.phone}</a></div>
          <time class="text-xs font-semibold text-zinc-500">{Beroon.Calendar.persian_datetime(lead.inserted_at)}</time>
        </div>
      </article>
    </div>
  </section>
</main>
