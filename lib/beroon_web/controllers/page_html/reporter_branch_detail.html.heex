<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-[#f6f4ef]" dir="rtl">
  <header class="border-b border-[#1c3a52]/10 bg-[#0f2942]">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-6 py-5">
      <div>
        <p class="text-lg font-black text-white">برون · پرتال گزارش‌دهی</p>
        <p class="mt-0.5 text-xs font-semibold text-[#9db4c7]">دسترسی فقط‌خواندنی به آمار روزانه‌ی ناوگان</p>
      </div>
      <.link href={~p"/logout"} method="delete" class="rounded-lg border border-white/15 px-4 py-2 text-sm font-bold text-white/80 transition hover:bg-white/10 hover:text-white">
        خروج
      </.link>
    </div>
  </header>

  <div class="mx-auto max-w-7xl px-6 py-8">
    <.link navigate={~p"/reports"} class="text-sm font-bold text-[#12283b] underline decoration-[#c9a24b] decoration-2 underline-offset-4">
      بازگشت به لیست شعب
    </.link>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-[#e4ddcd] bg-white p-6 shadow-sm">
      <div>
        <h1 class="text-xl font-black text-[#12283b]">{@branch.name}</h1>
        <p class="mt-1 text-sm text-[#6b7280]">آمار شب — {Beroon.Calendar.persian_date(@selected_date)}</p>
      </div>

      <div class="flex items-center gap-2">
        <form method="get" class="flex items-center gap-2">
          <input
            type="text"
            name="date"
            value={Beroon.Calendar.persian_numeric_date(@selected_date)}
            placeholder="۱۴۰۵/۰۵/۰۱"
            class="w-36 rounded-lg border border-[#dcd4bf] bg-[#faf8f2] px-3 py-2 text-sm font-bold text-[#12283b] focus:border-[#c9a24b] focus:outline-none"
          />
          <button class="rounded-lg bg-[#12283b] px-4 py-2 text-sm font-bold text-white hover:bg-[#0f2942]">نمایش</button>
        </form>
        <button
          type="button"
          id="export-evening-audit-image"
          data-audit={@audit_export_json}
          class="flex items-center gap-2 rounded-lg bg-[#c9a24b] px-4 py-2 text-sm font-black text-[#12283b] hover:bg-[#b8923f]"
        >
          <.icon name="hero-photo" class="size-4" />دانلود عکس ریز آمار
        </button>
      </div>
    </div>

    <div :if={!@audit.submitted} class="mt-4 rounded-xl border border-[#e4ddcd] bg-white p-4 text-sm font-semibold text-[#6b7280]">
      برای این شعبه در این تاریخ، آمار شب هنوز ثبت نشده است.
    </div>

    <section class="mt-6 grid gap-4 lg:grid-cols-4">
      <article class="rounded-2xl border border-[#e4ddcd] bg-white shadow-sm">
        <div class="border-b border-[#eee7d8] bg-[#eaf3ec] px-5 py-4">
          <p class="text-sm font-black text-[#2f7a4f]">اسکن‌شده</p>
          <p class="mt-1 text-3xl font-black text-[#12283b]">{length(@audit.scanned)}</p>
        </div>
        <div class="max-h-80 overflow-y-auto p-4 grid gap-2">
          <p :if={@audit.scanned == []} class="text-sm text-[#8a8171]">موردی ثبت نشده است.</p>
          <div :for={item <- @audit.scanned} class="rounded-lg bg-[#faf8f2] p-3">
            <p class="font-black text-[#12283b]">{item.plate}</p>
            <p class="mt-1 text-xs text-[#8a8171]">
              {Enum.reject([item.device_type_identifier, item.device_type_category, item.device_type_name], &(&1 in [nil, ""])) |> Enum.join(" - ")}
            </p>
          </div>
        </div>
      </article>

      <article class="rounded-2xl border border-[#e4ddcd] bg-white shadow-sm">
        <div class="border-b border-[#eee7d8] bg-[#eaf1f8] px-5 py-4">
          <p class="text-sm font-black text-[#2563a8]">جابجا شده</p>
          <p class="mt-1 text-3xl font-black text-[#12283b]">{length(@audit.moved)}</p>
        </div>
        <div class="max-h-80 overflow-y-auto p-4 grid gap-2">
          <p :if={@audit.moved == []} class="text-sm text-[#8a8171]">موردی وجود ندارد.</p>
          <div :for={item <- @audit.moved} class="rounded-lg bg-[#faf8f2] p-3">
            <p class="font-black text-[#12283b]">{item.plate}</p>
            <p class="mt-1 text-xs font-bold text-[#2563a8]">{item.accounted_reason}</p>
          </div>
        </div>
      </article>

      <article class="rounded-2xl border border-[#e4ddcd] bg-white shadow-sm">
        <div class="border-b border-[#eee7d8] bg-[#f2eaf8] px-5 py-4">
          <p class="text-sm font-black text-[#6d3fa0]">تعمیرگاه، امانی، سرقتی</p>
          <p class="mt-1 text-3xl font-black text-[#12283b]">{length(@audit.workshop)}</p>
        </div>
        <div class="max-h-80 overflow-y-auto p-4 grid gap-2">
          <p :if={@audit.workshop == []} class="text-sm text-[#8a8171]">موردی وجود ندارد.</p>
          <div :for={item <- @audit.workshop} class="rounded-lg bg-[#faf8f2] p-3">
            <p class="font-black text-[#12283b]">{item.plate}</p>
            <p class="mt-1 text-xs font-bold text-[#6d3fa0]">{item.accounted_reason}</p>
          </div>
        </div>
      </article>

      <article class="rounded-2xl border border-[#e4ddcd] bg-white shadow-sm">
        <div class="border-b border-[#eee7d8] bg-[#faeaea] px-5 py-4">
          <p class="text-sm font-black text-[#a5423a]">نیاز به بررسی</p>
          <p class="mt-1 text-3xl font-black text-[#12283b]">{length(@audit.needs_review)}</p>
        </div>
        <div class="max-h-80 overflow-y-auto p-4 grid gap-2">
          <p :if={@audit.needs_review == []} class="text-sm text-[#8a8171]">دستگاه بدون توضیح باقی نمانده است.</p>
          <div :for={item <- @audit.needs_review} class="rounded-lg bg-[#faf8f2] p-3">
            <p class="font-black text-[#12283b]">{item.plate}</p>
            <p class="mt-1 text-xs text-[#8a8171]">
              {Enum.reject([item.device_type_identifier, item.device_type_category, item.device_type_name], &(&1 in [nil, ""])) |> Enum.join(" - ")}
            </p>
          </div>
        </div>
      </article>
    </section>
  </div>
</main>
