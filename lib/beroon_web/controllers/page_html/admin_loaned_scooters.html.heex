<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950" dir="rtl"><section class="mx-auto min-h-screen w-full max-w-3xl bg-stone-50 p-5">
<.link navigate={~p"/admin/reports"} class="text-sm font-bold text-orange-700">بازگشت</.link><h1 class="mt-2 text-2xl font-black">دستگاه‌های امانی</h1>
<form method="post" action={~p"/admin/loaned-scooters"} class="mt-4 grid gap-3 rounded-xl bg-white p-4"><input type="hidden" name="_csrf_token" value={get_csrf_token()} /><input name="loan[code]" class="input input-bordered" placeholder="پلاک یا QR دستگاه" required/><input name="loan[unit_name]" class="input input-bordered" placeholder="نام واحد امانت‌گیرنده" required/><textarea name="loan[notes]" class="textarea textarea-bordered" placeholder="توضیحات اختیاری"></textarea><button class="btn btn-primary">ثبت امانت</button></form>
<section class="mt-5 grid gap-3"><article :for={loan <- @loans} class="rounded-xl border border-red-200 bg-white p-4"><div class="flex justify-between gap-3"><div><p class="font-black">پلاک {loan.scooter.plate}</p><p class="mt-1 text-sm font-bold text-zinc-700">نوع: {device_type_label(loan.scooter.device_type)}</p><p class="text-sm text-zinc-600">واحد: {loan.unit_name}</p><p class="text-xs text-zinc-500">{Beroon.Calendar.persian_datetime(loan.loaned_at)}</p></div><span class="h-fit rounded bg-red-100 px-2 py-1 text-xs font-black text-red-700">امانی</span></div><form method="post" action={~p"/admin/loaned-scooters/#{loan.id}/return"} class="mt-3"><input type="hidden" name="_csrf_token" value={get_csrf_token()} /><button class="btn btn-sm">ثبت بازگشت</button></form></article></section>
</section></main>