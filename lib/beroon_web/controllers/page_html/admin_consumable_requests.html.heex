<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <section class="mx-auto min-h-screen w-full max-w-2xl bg-stone-50 px-4 pb-24 pt-5">
    <.link navigate={~p"/admin/consumables"} class="text-sm font-bold text-orange-700">بازگشت به انبار مصرفی</.link>
    <div class="mt-2 flex items-center justify-between gap-3">
      <div>
        <h1 class="text-2xl font-black">درخواست‌های شعب</h1>
        <p class="mt-1 text-sm text-zinc-500">درخواست‌های کالای مصرفی هر شعبه؛ با تأیید، موجودی انبار مصرفی خودکار کم می‌شود.</p>
      </div>
      <.icon name="hero-inbox-arrow-down" class="size-9 text-sky-600" />
    </div>

    <p :if={@requests == []} class="mt-5 rounded-lg border border-zinc-200 bg-white p-4 text-sm text-zinc-500">
      هنوز درخواستی ثبت نشده است.
    </p>

    <div class="mt-4 grid gap-3">
      <article
        :for={request <- @requests}
        class={[
          "rounded-2xl border bg-white p-4 shadow-sm",
          case request.status do
            "pending" -> "border-sky-300"
            "approved" -> "border-emerald-200"
            _ -> "border-zinc-200"
          end
        ]}
      >
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="font-black text-zinc-950">{request.branch && request.branch.name}</p>
            <p class="mt-1 text-xs text-zinc-500">{Beroon.Calendar.persian_datetime(request.requested_at)}</p>
          </div>
          <span class={[
            "rounded-full px-3 py-1 text-xs font-black",
            case request.status do
              "pending" -> "bg-sky-100 text-sky-800"
              "approved" -> "bg-emerald-100 text-emerald-800"
              _ -> "bg-zinc-100 text-zinc-600"
            end
          ]}>
            {case request.status do
              "pending" -> "در انتظار بررسی"
              "approved" -> "تأیید شده"
              _ -> "رد شده"
            end}
          </span>
        </div>

        <div class="mt-3 grid gap-1.5">
          <p :for={item <- request.items} class="rounded-lg bg-zinc-50 px-3 py-2 text-sm">
            <span class="font-black text-zinc-950">{item.consumable_name}</span>
            <span class="mr-1 text-zinc-500">× {item.quantity}</span>
          </p>
        </div>

        <div :if={request.status == "pending"} class="mt-3 grid grid-cols-2 gap-2">
          <form method="post" action={~p"/admin/consumables/requests/#{request.id}/approve"}>
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button class="btn btn-sm btn-primary w-full">تأیید</button>
          </form>
          <form method="post" action={~p"/admin/consumables/requests/#{request.id}/reject"}>
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button class="btn btn-sm btn-error btn-outline w-full">رد</button>
          </form>
        </div>
      </article>
    </div>
  </section>
</main>
