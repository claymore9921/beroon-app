<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <section class="mx-auto min-h-screen w-full max-w-md bg-stone-50 px-4 pb-28 pt-5">
    <.link navigate={~p"/admin/device-locations"} class="text-sm font-bold text-orange-700">بازگشت</.link>

    <section class="mt-4 rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-xs font-bold text-zinc-500">پلاک دستگاه</p>
          <h1 class="mt-1 text-3xl font-black text-zinc-950">{@scooter.plate}</h1>
          <p class="mt-2 text-sm font-bold text-zinc-700">نوع دستگاه: {device_type_label(@scooter.device_type)}</p>
        </div>
        <.icon name="hero-qr-code" class="size-9 text-orange-600" />
      </div>

      <div class="mt-4 grid grid-cols-2 gap-3">
        <div class="rounded-xl bg-zinc-50 p-3">
          <p class="text-xs text-zinc-500">شعبه مالک</p>
          <p class="mt-1 font-black">{if @scooter.branch, do: @scooter.branch.name, else: "-"}</p>
        </div>
        <div class="rounded-xl bg-emerald-50 p-3">
          <p class="text-xs text-emerald-700">محل فعلی</p>
          <p class="mt-1 font-black text-emerald-900">{if @scooter.current_branch, do: @scooter.current_branch.name, else: "نامشخص"}</p>
        </div>
      </div>
    </section>

    <section class="mt-4 rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm">
      <h2 class="font-black text-zinc-950">۱۰ موقعیت آخر دستگاه</h2>

      <p :if={@location_history == []} class="mt-3 rounded-xl bg-zinc-50 p-3 text-sm text-zinc-500">
        سابقه موقعیتی برای این دستگاه ثبت نشده است.
      </p>

      <div :if={@location_history != []} class="mt-3 grid gap-2">
        <article :for={{event, index} <- Enum.with_index(@location_history, 1)} class="flex items-center justify-between gap-3 rounded-xl border border-zinc-200 bg-zinc-50 p-3">
          <div>
            <p class="font-black text-zinc-900">{index}. {if event.branch, do: event.branch.name, else: "نامشخص"}</p>
            <p class="mt-1 text-xs text-zinc-500">{Beroon.Calendar.persian_datetime(event.observed_at)}</p>
          </div>
          <.icon name="hero-map-pin" class="size-5 text-zinc-500" />
        </article>
      </div>
    </section>
  </section>
</main>
