<Layouts.flash_group flash={@flash} />
<main class="manager-dashboard-shell min-h-screen text-zinc-950" dir="rtl">
  <section class="manager-dashboard mx-auto min-h-screen w-full max-w-md px-4 pb-32 pt-6">
    <header class="manager-scan-header">
      <div>
        <.link navigate={~p"/manager"} class="text-sm font-semibold text-orange-700">
          بازگشت
        </.link>
        <p class="mt-3 text-sm font-black text-teal-700">مدیریت گزارش شعبه</p>
        <h1 class="mt-1 text-2xl font-black text-zinc-950">گزارش روزانه</h1>
        <span class="mt-1 block text-sm font-bold text-zinc-500">
          {@branch.name} · {@persian_today}
        </span>
      </div>
      <div class="manager-scan-orb">
        <.icon name="hero-qr-code" class="size-9" />
      </div>
    </header>

    <section class="mt-5 grid gap-4">
      <.link navigate={~p"/manager/morning"} class="manager-scan-action-card is-morning">
        <div class="manager-scan-action-icon">
          <.icon name="hero-sun" class="size-9" />
        </div>
        <div class="min-w-0">
          <h2>چک لیست صبح</h2>
          <p>اسکن پلاک دستگاه و ثبت چک‌لیست همان دستگاه</p>
          <span class={[
            "manager-scan-state",
            if(@morning_submitted, do: "is-success", else: "is-danger")
          ]}>
            {if @morning_submitted, do: "ثبت شده", else: "در انتظار ثبت"}
          </span>
        </div>
        <.icon class="size-9 manager-scan-arrow" name="hero-chevron-left" />
      </.link>

      <.link navigate={~p"/manager/evening"} class="manager-scan-action-card is-evening">
        <div class="manager-scan-action-icon">
          <.icon name="hero-moon" class="size-9" />
        </div>
        <div class="min-w-0">
          <h2>آمار شب</h2>
          <p>اسکن دستگاه‌های موجود در پایان روز و ارسال آمار شعبه</p>
          <span class={[
            "manager-scan-state",
            if(@evening_submitted, do: "is-success", else: "is-danger")
          ]}>
            {if @evening_submitted, do: "ثبت شده", else: "در انتظار ثبت"}
          </span>
        </div>
        <.icon class="size-9 manager-scan-arrow" name="hero-chevron-left" />
      </.link>

      <section class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm">
        <div class="flex items-center gap-3">
          <div class="manager-scan-action-icon"><.icon name="hero-banknotes" class="size-9" /></div>
          <div><h2 class="font-black text-zinc-950">گزارش درآمد نقدی و کارت به کارت</h2><p class="text-sm text-zinc-500">مبالغ درآمد امروز را به تومان ثبت کنید.</p></div>
        </div>
        <form method="post" action={~p"/manager/daily-revenue"} class="mt-4 grid gap-3">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <label class="grid gap-1"><span class="text-sm font-bold">درآمد کارت به کارت</span><input type="number" min="0" name="revenue[card_to_card_amount]" value={@daily_revenue && @daily_revenue.card_to_card_amount || 0} class="input input-bordered w-full" required /></label>
          <label class="grid gap-1"><span class="text-sm font-bold">درآمد نقدی</span><input type="number" min="0" name="revenue[cash_amount]" value={@daily_revenue && @daily_revenue.cash_amount || 0} class="input input-bordered w-full" required /></label>
          <button class="btn btn-primary w-full">ثبت گزارش درآمد</button>
        </form>
      </section>
    </section>
  </section>

  <.manager_bottom_nav active="scan" />
</main>
