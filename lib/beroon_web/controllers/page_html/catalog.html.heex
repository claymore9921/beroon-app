<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#002c44" />
    <title>کاتالوگ فروش برون</title>
    <style>
      @font-face {
        font-family: "Peyda";
        src: url("/fonts/PeydaWebFaNum-Regular.woff") format("woff");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Peyda";
        src: url("/fonts/PeydaWebFaNum-SemiBold.woff") format("woff");
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Peyda";
        src: url("/fonts/PeydaWebFaNum-Bold.woff") format("woff");
        font-weight: 700 900;
        font-style: normal;
        font-display: swap;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; background: #001827; color: #fff; }
      body {
        font-family: "Peyda", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        overscroll-behavior-y: none;
      }
      button { font: inherit; }

      .catalog-shell {
        min-height: 100dvh;
        display: flex;
        justify-content: center;
        background:
          radial-gradient(circle at 50% -8%, rgba(47, 221, 235, .22), transparent 34%),
          radial-gradient(circle at 50% 72%, rgba(0, 137, 178, .12), transparent 42%),
          linear-gradient(180deg, #00273b 0%, #001827 52%, #00131f 100%);
        overflow-x: hidden;
      }

      .catalog-stage {
        width: min(100%, 620px);
        min-height: 100dvh;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: max(14px, env(safe-area-inset-top)) 14px calc(90px + env(safe-area-inset-bottom));
      }

      .catalog-brand {
        flex: 0 0 auto;
        width: 100%;
        min-height: 76px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2px 0 10px;
        z-index: 10;
      }
      .catalog-brand img {
        display: block;
        width: clamp(74px, 20vw, 108px);
        height: auto;
        filter: drop-shadow(0 0 16px rgba(61, 218, 216, .20));
        user-select: none;
        -webkit-user-drag: none;
      }

      .catalog-center {
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4px 0 12px;
      }

      .catalog-image-wrap {
        position: relative;
        width: fit-content;
        max-width: 100%;
        max-height: calc(100dvh - 182px - env(safe-area-inset-top) - env(safe-area-inset-bottom));
        line-height: 0;
        overflow: hidden;
        border-radius: 18px;
        background: rgba(0, 24, 39, .72);
        box-shadow:
          0 22px 55px rgba(0, 4, 12, .36),
          0 0 0 1px rgba(108, 229, 243, .10),
          0 0 42px rgba(0, 200, 230, .10);
        isolation: isolate;
        transition: box-shadow 420ms ease, transform 420ms cubic-bezier(.22, 1, .36, 1);
      }
      .catalog-image-wrap.is-transitioning {
        box-shadow:
          0 26px 68px rgba(0, 4, 12, .42),
          0 0 0 1px rgba(135, 241, 255, .24),
          0 0 58px rgba(0, 213, 241, .22);
      }
      .catalog-image-wrap::after {
        content: "";
        position: absolute;
        inset: -18%;
        z-index: 8;
        pointer-events: none;
        background: linear-gradient(115deg, transparent 35%, rgba(113, 238, 255, .16) 50%, transparent 65%);
        opacity: 0;
        transform: translateX(-60%) skewX(-8deg);
      }
      .catalog-image-wrap.is-transitioning::after {
        animation: catalog-sheen 650ms cubic-bezier(.22, 1, .36, 1);
      }

      .catalog-image {
        display: block;
        width: auto;
        max-width: 100%;
        height: auto;
        max-height: calc(100dvh - 182px - env(safe-area-inset-top) - env(safe-area-inset-bottom));
        object-fit: contain;
        user-select: none;
        -webkit-user-drag: none;
        transform-origin: center center;
        will-change: opacity, transform, filter;
      }
      .catalog-image.is-leaving {
        animation: catalog-leave 185ms cubic-bezier(.4, 0, 1, 1) both;
      }
      .catalog-image.is-entering {
        animation: catalog-enter 520ms cubic-bezier(.16, 1, .3, 1) both;
      }

      @keyframes catalog-leave {
        from { opacity: 1; transform: scale(1) translateY(0); filter: blur(0) saturate(1); }
        to { opacity: 0; transform: scale(.965) translateY(8px); filter: blur(5px) saturate(.85); }
      }
      @keyframes catalog-enter {
        0% { opacity: 0; transform: scale(.94) translateY(-9px); filter: blur(7px) saturate(.82); }
        58% { opacity: 1; transform: scale(1.012) translateY(0); filter: blur(0) saturate(1.06); }
        100% { opacity: 1; transform: scale(1) translateY(0); filter: blur(0) saturate(1); }
      }
      @keyframes catalog-sheen {
        0% { opacity: 0; transform: translateX(-65%) skewX(-8deg); }
        22% { opacity: .78; }
        100% { opacity: 0; transform: translateX(65%) skewX(-8deg); }
      }

      .catalog-hotspots {
        position: absolute;
        inset: 0;
        display: none;
        z-index: 4;
      }
      .catalog-hotspots.is-visible { display: block; }
      .catalog-about-hotspots { position: absolute; inset: 0; display: none; z-index: 5; }
      .catalog-about-hotspots.is-visible { display: block; }
      .catalog-about-hotspot { position: absolute; left: 0; width: 100%; height: 50%; border: 0; background: transparent; cursor: pointer; -webkit-tap-highlight-color: transparent; }
      .catalog-about-hotspot.top { top: 0; }
      .catalog-about-hotspot.bottom { bottom: 0; }
      .catalog-about-hotspot:focus-visible { outline: 3px solid rgba(255,255,255,.95); outline-offset: -5px; }
      .catalog-hotspot {
        position: absolute;
        width: 50%;
        height: 50%;
        border: 0;
        background: transparent;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }
      .catalog-hotspot:focus-visible {
        outline: 3px solid rgba(255,255,255,.95);
        outline-offset: -5px;
      }
      .hotspot-top-right { top: 0; right: 0; }
      .hotspot-top-left { top: 0; left: 0; }
      .hotspot-bottom-right { bottom: 0; right: 0; }
      .hotspot-bottom-left { bottom: 0; left: 0; }

      .catalog-actions {
        position: fixed;
        z-index: 30;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: min(100%, 620px);
        padding: 13px 14px calc(13px + env(safe-area-inset-bottom));
        display: grid;
        gap: 9px;
        grid-template-columns: repeat(var(--action-count, 1), minmax(0, 1fr));
        background: linear-gradient(to top, rgba(0, 13, 23, .99) 55%, rgba(0, 13, 23, .84) 78%, transparent);
        pointer-events: none;
      }
      .catalog-action {
        min-height: 50px;
        border-radius: 15px;
        border: 1px solid rgba(68, 226, 255, .68);
        background: rgba(4, 48, 70, .94);
        box-shadow: 0 0 18px rgba(36, 216, 255, .16), inset 0 0 14px rgba(38, 203, 255, .07);
        color: white;
        font-family: "Peyda", ui-sans-serif, system-ui, sans-serif;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: 0;
        cursor: pointer;
        pointer-events: auto;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        -webkit-tap-highlight-color: transparent;
        transition: transform 150ms cubic-bezier(.22, 1, .36, 1), background 150ms ease, box-shadow 150ms ease;
      }
      .catalog-action:active {
        transform: scale(.965);
        background: rgba(8, 72, 99, .98);
        box-shadow: 0 0 28px rgba(36, 216, 255, .25);
      }
      .catalog-action.primary {
        background: linear-gradient(135deg, #0eb6c8, #007995);
        border-color: rgba(151, 247, 255, .95);
      }

      .catalog-hint {
        position: absolute;
        z-index: 6;
        left: 50%;
        bottom: 14px;
        transform: translateX(-50%);
        padding: 7px 12px;
        border-radius: 999px;
        background: rgba(0, 20, 31, .76);
        border: 1px solid rgba(117, 229, 255, .5);
        color: rgba(255,255,255,.94);
        font-family: "Peyda", ui-sans-serif, system-ui, sans-serif;
        font-size: 12px;
        line-height: 1.5;
        white-space: nowrap;
        backdrop-filter: blur(7px);
        display: none;
      }
      .catalog-hint.is-visible { display: block; }

      @media (max-height: 650px) {
        .catalog-brand { min-height: 58px; padding-bottom: 5px; }
        .catalog-brand img { width: 64px; }
        .catalog-image-wrap,
        .catalog-image { max-height: calc(100dvh - 154px - env(safe-area-inset-top) - env(safe-area-inset-bottom)); }
      }

      @media (min-width: 621px) {
        .catalog-stage { border-inline: 1px solid rgba(88, 215, 235, .06); }
      }

      @media (prefers-reduced-motion: reduce) {
        .catalog-image.is-leaving,
        .catalog-image.is-entering,
        .catalog-image-wrap.is-transitioning::after { animation-duration: 1ms !important; }
      }

      .lead-modal { border:0; padding:0; width:min(92vw,420px); border-radius:24px; background:#fff; color:#18181b; box-shadow:0 24px 80px rgba(0,0,0,.45); }
      .lead-modal::backdrop { background:rgba(0,16,28,.78); backdrop-filter:blur(6px); }
      .lead-form { padding:22px; direction:rtl; }
      .lead-form h2 { margin:0 0 6px; font-size:22px; font-weight:900; }
      .lead-form p { margin:0 0 18px; color:#71717a; font-size:14px; line-height:1.8; }
      .lead-form label { display:block; margin:12px 0 6px; font-size:13px; font-weight:800; }
      .lead-form input { width:100%; min-height:50px; border:1px solid #d4d4d8; border-radius:14px; padding:0 14px; font:inherit; outline:none; }
      .lead-form input:focus { border-color:#0d9488; box-shadow:0 0 0 3px rgba(13,148,136,.12); }
      .lead-submit { width:100%; min-height:52px; margin-top:16px; border:0; border-radius:14px; background:#0f766e; color:white; font:inherit; font-weight:900; cursor:pointer; }
      .lead-error { margin-top:10px !important; color:#b91c1c !important; font-weight:800; }
    </style>
  </head>
  <body>
    <main class="catalog-shell" aria-label="کاتالوگ فروش برون">
      <section class="catalog-stage" id="catalog-stage">
        <header class="catalog-brand" aria-label="برون">
          <img src="/images/beroon-logo.png" alt="لوگوی برون" draggable="false" />
        </header>

        <div class="catalog-center">
          <div class="catalog-image-wrap" id="catalog-image-wrap">
          <img
            id="catalog-image"
            class="catalog-image"
            src="/images/catalog/1.jpg"
            alt="کاتالوگ فروش برون"
            draggable="false"
          />

          <div id="catalog-hotspots" class="catalog-hotspots" aria-label="انتخاب دستگاه">
            <button class="catalog-hotspot hotspot-top-right" type="button" data-product="s" aria-label="اسکوتر شیائومی"></button>
            <button class="catalog-hotspot hotspot-top-left" type="button" data-product="h" aria-label="دوچرخه برقی H1"></button>
            <button class="catalog-hotspot hotspot-bottom-right" type="button" data-product="x9" aria-label="اسکوتر X9"></button>
            <button class="catalog-hotspot hotspot-bottom-left" type="button" data-product="h1" aria-label="مینی هارلی"></button>
          </div>

          <div id="catalog-about-hotspots" class="catalog-about-hotspots" aria-label="راه‌های ارتباطی">
            <button class="catalog-about-hotspot top" type="button" data-about-action="call" aria-label="تماس با برون"></button>
            <button class="catalog-about-hotspot bottom" type="button" data-about-action="instagram" aria-label="اینستاگرام برون"></button>
          </div>

            <div id="catalog-hint" class="catalog-hint">روی دستگاه موردنظر بزنید</div>
          </div>
        </div>

        <div id="catalog-actions" class="catalog-actions" style="--action-count: 1"></div>
      </section>
    </main>


    <dialog id="catalog-lead-modal" class="lead-modal">
      <form class="lead-form" action="/catalog/leads" method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <h2>قبل از مشاهده دستگاه‌ها</h2>
        <p>نام و شماره تماس خود را ثبت کنید تا کاتالوگ محصولات برای شما باز شود.</p>
        <label for="lead-name">نام و نام خانوادگی</label>
        <input id="lead-name" name="lead[name]" required minlength="2" maxlength="80" autocomplete="name" />
        <label for="lead-phone">شماره موبایل</label>
        <input id="lead-phone" name="lead[phone]" required inputmode="numeric" pattern="09[0-9]{9}" maxlength="11" placeholder="09xxxxxxxxx" autocomplete="tel" dir="ltr" />
        <p :if={@lead_error} class="lead-error">اطلاعات واردشده معتبر نیست. لطفاً نام و شماره موبایل صحیح وارد کنید.</p>
        <button class="lead-submit" type="submit">ثبت و مشاهده دستگاه‌ها</button>
      </form>
    </dialog>

    <script>
      (() => {
        const image = document.getElementById("catalog-image")
        const imageWrap = document.getElementById("catalog-image-wrap")
        const actions = document.getElementById("catalog-actions")
        const hotspots = document.getElementById("catalog-hotspots")
        const aboutHotspots = document.getElementById("catalog-about-hotspots")
        const hint = document.getElementById("catalog-hint")
        const leadModal = document.getElementById("catalog-lead-modal")
        const unlocked = new URLSearchParams(window.location.search).get("unlocked") === "1"

        const products = {
          s: ["s1.jpg", "s2.jpg", "s3.jpg"],
          h: ["h1.jpg", "h2.jpg", "h3.jpg"],
          x9: ["x91.jpg", "x92.jpg", "x93.jpg"],
          h1: ["h11.jpg", "h12.jpg", "h13.jpg"],
        }

        let state = {screen: "cover", product: null, step: 0}
        const history = []
        let transitionTimer = null
        let transitionToken = 0

        const imagePath = (filename) => `/images/catalog/${filename}`

        const setImage = (filename, alt = "کاتالوگ فروش برون") => {
          const target = imagePath(filename)
          if (image.getAttribute("src") === target && !image.classList.contains("is-leaving")) {
            image.alt = alt
            return
          }

          const token = ++transitionToken
          clearTimeout(transitionTimer)
          image.classList.remove("is-entering")
          image.classList.add("is-leaving")
          imageWrap.classList.add("is-transitioning")

          const next = new Image()
          next.src = target

          const swap = () => {
            if (token !== transitionToken) return
            image.src = target
            image.alt = alt
            image.classList.remove("is-leaving")
            void image.offsetWidth
            image.classList.add("is-entering")
            transitionTimer = setTimeout(() => {
              if (token !== transitionToken) return
              image.classList.remove("is-entering")
              imageWrap.classList.remove("is-transitioning")
            }, 560)
          }

          next.onload = () => setTimeout(swap, 150)
          next.onerror = () => {
            image.classList.remove("is-leaving", "is-entering")
            imageWrap.classList.remove("is-transitioning")
          }
        }

        const setActions = (items) => {
          actions.innerHTML = ""
          actions.style.setProperty("--action-count", String(Math.max(1, items.length)))
          items.forEach((item) => {
            const button = document.createElement("button")
            button.type = "button"
            button.className = `catalog-action${item.primary ? " primary" : ""}`
            button.textContent = item.label
            button.addEventListener("click", item.onClick)
            actions.appendChild(button)
          })
        }

        const snapshot = () => ({...state})

        const navigate = (next, remember = true) => {
          if (remember) history.push(snapshot())
          state = {...next}
          render()
        }

        const goBack = () => {
          const previous = history.pop()
          if (!previous) {
            state = {screen: "cover", product: null, step: 0}
          } else {
            state = previous
          }
          render()
        }

        const render = () => {
          hotspots.classList.remove("is-visible")
          aboutHotspots.classList.remove("is-visible")
          hint.classList.remove("is-visible")

          if (state.screen === "cover") {
            setImage("1.jpg", "فروش انواع اسکوتر و دوچرخه برقی برون")
            setActions([{label: "دستگاه‌ها", primary: true, onClick: () => {
              if (unlocked) navigate({screen: "products", product: null, step: 0})
              else leadModal.showModal()
            }}])
            return
          }

          if (state.screen === "products") {
            setImage("2.jpg", "انتخاب دستگاه‌های کاتالوگ برون")
            hotspots.classList.add("is-visible")
            hint.classList.add("is-visible")
            setActions([{label: "بازگشت", onClick: goBack}])
            return
          }

          if (state.screen === "services") {
            setImage("services.jpg", "خدمات پس از فروش برون")
            setActions([{label: "بازگشت", onClick: goBack}])
            return
          }

          if (state.screen === "about") {
            setImage("about-us.jpg", "راه‌های ارتباطی برون")
            aboutHotspots.classList.add("is-visible")
            setActions([{label: "بازگشت", onClick: goBack}])
            return
          }

          const files = products[state.product]
          if (!files) return

          const index = Math.max(0, Math.min(2, state.step - 1))
          setImage(files[index], "مشخصات دستگاه برون")

          if (state.step === 1) {
            setActions([
              {label: "بازگشت", onClick: goBack},
              {label: "مشخصات", primary: true, onClick: () => navigate({screen: "product", product: state.product, step: 2})},
            ])
          } else if (state.step === 2) {
            setActions([
              {label: "بازگشت", onClick: goBack},
              {label: "شرایط پرداخت", primary: true, onClick: () => navigate({screen: "product", product: state.product, step: 3})},
            ])
          } else {
            setActions([
              {label: "بازگشت", onClick: goBack},
              {label: "خدمات پس از فروش", onClick: () => navigate({screen: "services", product: state.product, step: 3})},
              {label: "ارتباط با ما", primary: true, onClick: () => navigate({screen: "about", product: state.product, step: 3})},
            ])
          }
        }

        hotspots.addEventListener("click", (event) => {
          const button = event.target.closest("[data-product]")
          if (!button) return
          const product = button.dataset.product
          if (!products[product]) return
          navigate({screen: "product", product, step: 1})
        })

        aboutHotspots.addEventListener("click", (event) => {
          const button = event.target.closest("[data-about-action]")
          if (!button) return
          if (button.dataset.aboutAction === "call") {
            window.location.href = "tel:09002791000"
          } else if (button.dataset.aboutAction === "instagram") {
            window.location.href = "https://instagram.com/beroon_app"
          }
        })

        // Preload catalog images after first paint for near-instant transitions.
        window.addEventListener("load", () => {
          ["2.jpg", "about-us.jpg", "services.jpg", ...Object.values(products).flat()].forEach((filename) => {
            const preload = new Image()
            preload.src = imagePath(filename)
          })
        }, {once: true})

        if (new URLSearchParams(window.location.search).get("lead_error") === "1") leadModal.showModal()
        render()
      })()
    </script>
  </body>
</html>
