<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <section class="mx-auto min-h-screen w-full max-w-6xl bg-stone-50 px-4 pb-24 pt-5">
    <header class="flex items-start justify-between gap-3 border-b border-zinc-200 pb-4">
      <div class="min-w-0">
        <.link navigate={~p"/admin/evening-reports"} class="text-sm font-semibold text-orange-700">
          بازگشت به شعبه‌ها
        </.link>
        <h1 class="mt-1 truncate text-2xl font-bold">آمار شب شعبه {@branch.name}</h1>
        <p class="mt-1 text-sm text-zinc-500">
          بازه گزارش: ساعت ۲۱:۰۰ تاریخ انتخاب‌شده تا ساعت ۰۶:۰۰ صبح روز بعد
        </p>
      </div>
      <.link href={~p"/logout"} method="delete" class="btn btn-ghost btn-sm">خروج</.link>
    </header>

    <form
      id="admin-branch-evening-filter"
      method="get"
      action={~p"/admin/evening-reports/branches/#{@branch}"}
      class="mt-4 grid grid-cols-[1fr_auto] items-end gap-2 rounded-xl border border-zinc-200 bg-white p-4 shadow-sm"
    >
      <label class="form-control min-w-0">
        <span class="label-text mb-2 font-bold">تاریخ شمسی آمار شب</span>
        <input
          type="text"
          name="date"
          value={Beroon.Calendar.persian_numeric_date(@selected_date)}
          placeholder="مثال: ۱۴۰۵/۰۵/۰۱"
          class="input input-bordered min-h-11 w-full"
        />
      </label>
      <button class="btn btn-neutral min-h-11">نمایش</button>
    </form>

    <section class="mt-4 grid grid-cols-3 gap-3 text-center">
      <article class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-emerald-900">
        <p class="text-xs font-bold">اسکن‌شده</p>
        <strong class="mt-1 block text-2xl">{length(@audit.scanned)}</strong>
      </article>
      <article class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-amber-900">
        <p class="text-xs font-bold">جابه‌جا‌شده</p>
        <strong class="mt-1 block text-2xl">{length(@audit.moved)}</strong>
      </article>
      <article class="rounded-xl border border-red-200 bg-red-50 p-3 text-red-900">
        <p class="text-xs font-bold">اسکن‌نشده</p>
        <strong class="mt-1 block text-2xl">{length(@audit.missing)}</strong>
      </article>
    </section>

    <div
      :if={!@audit.submitted}
      class="mt-4 rounded-xl border border-zinc-200 bg-white p-4 text-sm font-semibold text-zinc-600"
    >
      برای این شعبه در بازه ۲۱:۰۰ {Beroon.Calendar.persian_numeric_date(@selected_date)} تا ۰۶:۰۰ روز بعد، آمار نهایی ثبت نشده است.
    </div>

    <section class="mt-5 grid gap-4 lg:grid-cols-3" aria-label="ریز آمار شب">
      <div class="rounded-2xl border border-emerald-200 bg-white p-4 shadow-sm">
        <div class="mb-3 flex items-center justify-between gap-2">
          <h2 class="font-black text-emerald-800">پلاک‌های اسکن‌شده</h2>
          <span class="rounded bg-emerald-100 px-2 py-1 text-xs font-black text-emerald-800">{length(@audit.scanned)}</span>
        </div>
        <p :if={@audit.scanned == []} class="text-sm text-zinc-500">موردی ثبت نشده است.</p>
        <div class="grid gap-2">
          <article :for={item <- @audit.scanned} class="rounded-lg border border-zinc-200 bg-zinc-50 p-3">
            <p class="font-black">پلاک {item.plate}</p>
            <p class="mt-1 text-xs text-zinc-500">QR: {item.barcode || "-"}</p>
            <p class="mt-1 text-xs font-semibold text-zinc-600">
              {Enum.reject([item.device_type_identifier, item.device_type_category, item.device_type_name], &(&1 in [nil, ""])) |> Enum.join(" - ")}
            </p>
          </article>
        </div>
      </div>

      <div class="rounded-2xl border border-amber-200 bg-white p-4 shadow-sm">
        <div class="mb-3 flex items-center justify-between gap-2">
          <h2 class="font-black text-amber-800">پلاک‌های جابه‌جا‌شده</h2>
          <span class="rounded bg-amber-100 px-2 py-1 text-xs font-black text-amber-800">{length(@audit.moved)}</span>
        </div>
        <p :if={@audit.moved == []} class="text-sm text-zinc-500">جابجایی در این بازه ثبت نشده است.</p>
        <div class="grid gap-2">
          <article :for={item <- @audit.moved} class="rounded-lg border border-amber-200 bg-amber-50 p-3">
            <div class="flex items-center justify-between gap-2">
              <p class="font-black">پلاک {item.plate}</p>
              <span class="rounded bg-amber-700 px-2 py-1 text-[11px] font-black text-white">
                {if item.direction == :out, do: "خروج از شعبه", else: "ورود به شعبه"}
              </span>
            </div>
            <p class="mt-2 text-xs text-zinc-700">
              {item.home_branch_name || "-"} ← {item.detected_branch_name || "-"}
            </p>
            <p class="mt-1 text-xs text-zinc-500">{Beroon.Calendar.persian_datetime(item.detected_at)}</p>
          </article>
        </div>
      </div>

      <div class="rounded-2xl border border-red-200 bg-white p-4 shadow-sm">
        <div class="mb-3 flex items-center justify-between gap-2">
          <h2 class="font-black text-red-800">پلاک‌های اسکن‌نشده</h2>
          <span class="rounded bg-red-100 px-2 py-1 text-xs font-black text-red-800">{length(@audit.missing)}</span>
        </div>
        <p :if={@audit.missing == []} class="text-sm text-zinc-500">همه دستگاه‌های مورد انتظار تعیین تکلیف شده‌اند.</p>
        <div class="grid gap-2">
          <article :for={item <- @audit.missing} class="rounded-lg border border-zinc-200 bg-zinc-50 p-3">
            <p class="font-black">پلاک {item.plate}</p>
            <p class="mt-1 text-xs text-zinc-500">QR: {item.barcode || "-"}</p>
            <p class="mt-1 text-xs font-semibold text-zinc-600">
              {Enum.reject([item.device_type_identifier, item.device_type_category, item.device_type_name], &(&1 in [nil, ""])) |> Enum.join(" - ")}
            </p>
          </article>
        </div>
      </div>
    </section>
  </section>
</main>
