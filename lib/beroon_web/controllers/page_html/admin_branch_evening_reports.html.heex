<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <section class="mx-auto min-h-screen w-full max-w-6xl bg-stone-50 px-4 pb-24 pt-5">
<form
      id="admin-branch-evening-filter"
      method="get"
      action={~p"/admin/evening-reports/branches/#{@branch}"}
      class="mt-4 grid grid-cols-[1fr_auto] items-end gap-2 rounded-xl border border-zinc-200 bg-white p-4 shadow-sm"
    >
      <label class="form-control min-w-0">
        <span class="label-text mb-2 font-bold">تاریخ شمسی آمار شب</span>
        <input
          type="text"
          name="date"
          value={Beroon.Calendar.persian_numeric_date(@selected_date)}
          placeholder="مثال: ۱۴۰۵/۰۵/۰۱"
          class="input input-bordered min-h-11 w-full"
        />
      </label>
      <button class="btn btn-neutral min-h-11">نمایش</button>
    </form>

    <div class="mt-3 flex justify-end">
      <button
        type="button"
        id="export-evening-audit-image"
        data-audit={@audit_export_json}
        class="btn btn-outline min-h-11 gap-2"
      >
        <.icon name="hero-photo" class="size-5" />
        <span>دانلود عکس ریز آمار</span>
      </button>
    </div>

    <div
      :if={!@audit.submitted}
      class="mt-4 rounded-xl border border-zinc-200 bg-white p-4 text-sm font-semibold text-zinc-600"
    >
      برای این شعبه در بازه ۲۱:۰۰ {Beroon.Calendar.persian_numeric_date(@selected_date)} تا ۰۶:۰۰ روز بعد، آمار نهایی ثبت نشده است.
    </div>

    <form
      :if={@audit.submitted}
      method="post"
      action={~p"/admin/evening-reports/branches/#{@branch}/reopen"}
      class="mt-4 rounded-xl border border-red-200 bg-red-50 p-4"
      onsubmit="return window.confirm('آیا مطمئن هستید؟ آمار شب این شعبه برای تاریخ انتخاب‌شده حذف می‌شود و مدیر شعبه می‌تواند از ابتدا آمارگیری کند.')"
    >
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input type="hidden" name="date" value={Beroon.Calendar.persian_numeric_date(@selected_date)} />
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-black text-red-900">آمار این شب اشتباه ثبت شده است؟</p>
          <p class="mt-1 text-xs font-semibold text-red-700">با بازکردن مجدد، آمار ثبت‌شده این شعبه برای همین شب حذف می‌شود تا مدیر شعبه از ابتدا ثبت کند.</p>
        </div>
        <button type="submit" class="btn btn-error min-h-11 shrink-0">بازکردن مجدد آمارگیری</button>
      </div>
    </form>

    <section class="mt-4 grid gap-3 lg:grid-cols-4" aria-label="خلاصه آمار شب">
      <details class="group rounded-2xl border border-emerald-200 bg-white shadow-sm">
        <summary class="cursor-pointer list-none rounded-2xl bg-emerald-50 p-4 text-center text-emerald-900 marker:hidden">
          <p class="text-sm font-black">اسکن‌شده</p>
          <strong class="mt-1 block text-3xl">{length(@audit.scanned)}</strong>
          <p class="mt-1 text-[11px] font-bold opacity-70">برای مشاهده پلاک‌ها کلیک کنید</p>
        </summary>
        <div class="grid gap-2 border-t border-emerald-100 p-4">
          <p :if={@audit.scanned == []} class="text-sm text-zinc-500">موردی ثبت نشده است.</p>
          <article :for={item <- @audit.scanned} class="rounded-lg border border-zinc-200 bg-zinc-50 p-3">
            <p class="font-black">پلاک <.admin_plate_link plate={item.plate} /></p>
            <p class="mt-1 text-xs text-zinc-500">QR: {item.barcode || "-"}</p>
            <p class="mt-1 text-xs font-semibold text-zinc-600">
              {Enum.reject([item.device_type_identifier, item.device_type_category, item.device_type_name], &(&1 in [nil, ""])) |> Enum.join(" - ")}
            </p>
          </article>
        </div>
      </details>

      <details class="group rounded-2xl border border-sky-200 bg-white shadow-sm">
        <summary class="cursor-pointer list-none rounded-2xl bg-sky-50 p-4 text-center text-sky-900 marker:hidden">
          <p class="text-sm font-black">جابجا شده</p>
          <strong class="mt-1 block text-3xl">{length(@audit.moved)}</strong>
          <p class="mt-1 text-[11px] font-bold opacity-70">برای مشاهده پلاک‌ها کلیک کنید</p>
        </summary>
        <div class="grid gap-2 border-t border-sky-100 p-4">
          <p :if={@audit.moved == []} class="text-sm text-zinc-500">موردی وجود ندارد.</p>
          <article :for={item <- @audit.moved} class="rounded-lg border border-sky-200 bg-sky-50 p-3">
            <p class="font-black">پلاک <.admin_plate_link plate={item.plate} /></p>
            <p class="mt-1 text-xs text-zinc-500">QR: {item.barcode || "-"}</p>
            <p class="mt-1 text-xs font-black text-sky-800">{item.accounted_reason}</p>
            <p class="mt-1 text-xs font-semibold text-zinc-600">
              {Enum.reject([item.device_type_identifier, item.device_type_category, item.device_type_name], &(&1 in [nil, ""])) |> Enum.join(" - ")}
            </p>
          </article>
        </div>
      </details>

      <details class="group rounded-2xl border border-violet-200 bg-white shadow-sm">
        <summary class="cursor-pointer list-none rounded-2xl bg-violet-50 p-4 text-center text-violet-900 marker:hidden">
          <p class="text-sm font-black">تعمیرگاه، امانی، سرقتی</p>
          <strong class="mt-1 block text-3xl">{length(@audit.workshop)}</strong>
          <p class="mt-1 text-[11px] font-bold opacity-70">برای مشاهده پلاک‌ها کلیک کنید</p>
        </summary>
        <div class="grid gap-2 border-t border-violet-100 p-4">
          <p :if={@audit.workshop == []} class="text-sm text-zinc-500">موردی وجود ندارد.</p>
          <article :for={item <- @audit.workshop} class="rounded-lg border border-violet-200 bg-violet-50 p-3">
            <p class="font-black">پلاک <.admin_plate_link plate={item.plate} /></p>
            <p class="mt-1 text-xs text-zinc-500">QR: {item.barcode || "-"}</p>
            <p class="mt-1 text-xs font-black text-violet-800">{item.accounted_reason}</p>
            <p class="mt-1 text-xs font-semibold text-zinc-600">
              {Enum.reject([item.device_type_identifier, item.device_type_category, item.device_type_name], &(&1 in [nil, ""])) |> Enum.join(" - ")}
            </p>
          </article>
        </div>
      </details>

      <details class="group rounded-2xl border border-red-200 bg-white shadow-sm">
        <summary class="cursor-pointer list-none rounded-2xl bg-red-50 p-4 text-center text-red-900 marker:hidden">
          <p class="text-sm font-black">نیاز به بررسی</p>
          <strong class="mt-1 block text-3xl">{length(@audit.needs_review)}</strong>
          <p class="mt-1 text-[11px] font-bold opacity-70">برای مشاهده پلاک‌ها کلیک کنید</p>
        </summary>
        <div class="grid gap-2 border-t border-red-100 p-4">
          <p :if={@audit.needs_review == []} class="text-sm text-zinc-500">دستگاه بدون توضیح باقی نمانده است.</p>
          <article :for={item <- @audit.needs_review} class="rounded-lg border border-red-200 bg-red-50 p-3">
            <p class="font-black">پلاک <.admin_plate_link plate={item.plate} /></p>
            <p class="mt-1 text-xs text-zinc-500">QR: {item.barcode || "-"}</p>
            <p class="mt-1 text-xs font-semibold text-zinc-600">
              {Enum.reject([item.device_type_identifier, item.device_type_category, item.device_type_name], &(&1 in [nil, ""])) |> Enum.join(" - ")}
            </p>
          </article>
        </div>
      </details>
    </section>
  </section>
</main>
