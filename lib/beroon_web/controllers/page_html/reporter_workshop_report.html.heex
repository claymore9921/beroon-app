<Layouts.flash_group flash={@flash} />
<.reporter_layout active="workshop">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black text-[#12283b]">عملکرد تعمیرگاه</h1>
      <p class="mt-1 text-sm font-medium text-[#6b7280]">تاریخ: {Beroon.Calendar.persian_date(@report_date)}</p>
    </div>
    <div class="flex items-center gap-3">
      <form method="get" class="flex items-center gap-2">
        <input
          type="text"
          name="date"
          value={Beroon.Calendar.persian_numeric_date(@report_date)}
          placeholder="۱۴۰۵/۰۵/۰۱"
          class="w-36 rounded-lg border border-[#dcd4bf] bg-white px-3 py-2 text-sm font-semibold text-[#12283b] focus:border-[#c9a24b] focus:outline-none"
        />
        <button class="rounded-lg bg-[#12283b] px-4 py-2 text-sm font-black text-white hover:bg-[#0f2942]">نمایش</button>
      </form>
      <.reporter_export_buttons export_json={@export_json} download_url={~p"/reports/workshop/download?date=#{Beroon.Calendar.persian_numeric_date(@report_date)}"} />
    </div>
  </div>

  <section class="mt-6 overflow-x-auto rounded-2xl border border-[#e4ddcd] bg-white shadow-sm">
    <table class="w-full text-right">
      <thead>
        <tr class="border-b border-[#eee7d8] text-xs font-semibold text-[#8a8171]">
          <th class="px-6 py-3">پلاک</th>
          <th class="px-6 py-3">نوع دستگاه</th>
          <th class="px-6 py-3">تعمیرکار</th>
          <th class="px-6 py-3">قطعات مصرف‌شده</th>
          <th class="px-6 py-3">توضیحات</th>
          <th class="px-6 py-3">زمان ترخیص</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={item <- @discharges} class="border-b border-[#f3efe3] last:border-0 hover:bg-[#faf8f2]">
          <td class="px-6 py-4 font-black text-[#12283b]">{item.plate || "-"}</td>
          <td class="px-6 py-4 text-sm text-[#4b5563]">
            {[item.device_type.category, item.device_type.device_model, item.device_type.device_identifier] |> Enum.reject(&(&1 in [nil, ""])) |> Enum.join(" ")}
          </td>
          <td class="px-6 py-4 text-sm font-semibold text-[#12283b]">{item.technician_name || "ثبت نشده"}</td>
          <td class="px-6 py-4 text-sm text-[#4b5563]">{format_parts_used(@usages_by_event, item.event_id)}</td>
          <td class="px-6 py-4 text-sm text-[#4b5563]">{item.discharge_notes || "-"}</td>
          <td class="px-6 py-4 text-sm text-[#8a8171]">{Beroon.Calendar.persian_datetime(item.discharged_at)}</td>
        </tr>
        <tr :if={@discharges == []}>
          <td colspan="6" class="px-6 py-10 text-center text-sm text-[#8a8171]">در این تاریخ ترخیصی ثبت نشده است.</td>
        </tr>
      </tbody>
    </table>
  </section>
</.reporter_layout>
