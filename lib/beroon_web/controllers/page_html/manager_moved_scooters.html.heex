<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <div class="mx-auto min-h-screen w-full max-w-md bg-stone-50 px-4 pb-24 pt-5">
    <div class="flex items-start justify-between gap-3">
      <div>
        <.link navigate={~p"/manager"} class="text-sm text-orange-700">بازگشت</.link>
        <h1 class="mt-1 text-2xl font-bold">دستگاه‌های جابجا شده</h1>
        <p class="mt-1 text-sm text-zinc-500">دستگاه‌های متعلق به {@branch.name} که آخرین بار در شعبه‌ی دیگری اسکن خورده‌اند.</p>
      </div>
    </div>

    <p :if={@scooters == []} class="mt-5 rounded-lg border border-zinc-200 bg-white p-4 text-sm text-zinc-500">
      در حال حاضر دستگاه جابجاشده‌ای برای این شعبه ثبت نشده است.
    </p>

    <div class="mt-4 grid gap-3">
      <article :for={scooter <- @scooters} class="rounded-2xl border border-sky-200 bg-white p-4 shadow-sm">
        <div class="flex items-center justify-between gap-2">
          <p class="font-black text-zinc-950">پلاک {scooter.plate}</p>
          <span class="rounded-full bg-sky-100 px-3 py-1 text-xs font-black text-sky-800">
            {scooter.current_branch_name || "نامشخص"}
          </span>
        </div>
        <p class="mt-1 text-xs text-zinc-500">QR: {scooter.barcode || "-"}</p>
        <p class="mt-1 text-xs font-semibold text-zinc-600">
          {Enum.reject([scooter.device_type_identifier, scooter.device_type_category, scooter.device_type_name], &(&1 in [nil, ""])) |> Enum.join(" - ")}
        </p>
        <p class="mt-2 text-xs font-bold text-zinc-700">
          آخرین اسکن:
          <%= if scooter.last_seen_at do %>
            {Beroon.Calendar.persian_datetime(scooter.last_seen_at)}
          <% else %>
            نامشخص
          <% end %>
        </p>
      </article>
    </div>
  </div>
</main>
