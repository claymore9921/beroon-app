<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <div class="mx-auto min-h-screen w-full max-w-md bg-stone-50 px-4 pb-24 pt-5">
    <div class="flex items-start justify-between gap-3">
      <div>
        <.link navigate={~p"/courier"} class="text-sm text-orange-700">بازگشت</.link>
        <h1 class="mt-1 text-2xl font-bold">حمل و نقل دستگاه</h1>
      </div>
      <.icon name="hero-truck" class="size-9 text-orange-600" />
    </div>

    <div class="mt-4 grid grid-cols-2 gap-3">
      <a href="#broken" class="flex items-center justify-center gap-2 rounded-xl bg-rose-600 px-3 py-3 text-sm font-black text-white shadow-sm">
        <.icon name="hero-exclamation-circle" class="size-5" />
        خراب ({Enum.reduce(@broken_by_branch, 0, fn {_b, s}, acc -> length(s) + acc end)})
      </a>
      <a href="#ready" class="flex items-center justify-center gap-2 rounded-xl bg-teal-600 px-3 py-3 text-sm font-black text-white shadow-sm">
        <.icon name="hero-check-badge" class="size-5" />
        آماده تحویل ({Enum.reduce(@ready_by_branch, 0, fn {_b, s}, acc -> length(s) + acc end)})
      </a>
    </div>

    <section id="broken" class="mt-6 scroll-mt-4 rounded-2xl border-2 border-rose-200 bg-rose-50/60 p-3">
      <h2 class="flex items-center gap-2 text-lg font-black text-rose-800">
        <span class="flex size-8 items-center justify-center rounded-full bg-rose-600 text-white">
          <.icon name="hero-wrench-screwdriver" class="size-4" />
        </span>
        دستگاه‌های خراب
      </h2>
      <p class="mt-1 text-xs font-semibold text-rose-700/80">این دستگاه‌ها را از شعبه تحویل بگیرید و به تعمیرگاه ببرید.</p>

      <p :if={@broken_by_branch == []} class="mt-3 rounded-lg border border-rose-200 bg-white p-4 text-sm text-zinc-500">
        دستگاه خرابی برای تحویل‌گیری وجود ندارد.
      </p>

      <div :for={{branch, scooters} <- @broken_by_branch} class="mt-3 overflow-hidden rounded-2xl border border-rose-200 bg-white shadow-sm">
        <header class="flex items-center justify-between gap-3 border-b border-rose-100 bg-rose-100/60 px-3 py-2.5">
          <h3 class="text-sm font-extrabold text-rose-900">{if branch, do: branch.name, else: "بدون شعبه"}</h3>
          <span class="rounded-full bg-rose-600 px-2.5 py-1 text-xs font-bold text-white">{length(scooters)} دستگاه</span>
        </header>

        <article :for={scooter <- scooters} class="border-r-4 border-rose-400 border-b border-b-zinc-100 p-3 last:border-b-0">
          <div class="flex items-center gap-2">
            <.icon name="hero-exclamation-circle" class="size-5 shrink-0 text-rose-500" />
            <div class="min-w-0">
              <p class="truncate text-sm font-bold text-zinc-950">پلاک {scooter.plate}</p>
              <p class="truncate text-xs text-zinc-500">{device_type_label(scooter.device_type)}</p>
            </div>
          </div>
          <form method="post" action={~p"/courier/scooters/#{scooter}/pickup"} class="mt-2">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button class="min-h-10 w-full rounded-lg bg-rose-600 text-sm font-black text-white hover:bg-rose-700">تحویل</button>
          </form>
        </article>
      </div>
    </section>

    <section id="ready" class="mt-6 scroll-mt-4 rounded-2xl border-2 border-teal-200 bg-teal-50/60 p-3">
      <h2 class="flex items-center gap-2 text-lg font-black text-teal-800">
        <span class="flex size-8 items-center justify-center rounded-full bg-teal-600 text-white">
          <.icon name="hero-check-badge" class="size-4" />
        </span>
        تعمیر شده (آماده تحویل)
      </h2>
      <p class="mt-1 text-xs font-semibold text-teal-700/80">این دستگاه‌ها را از تعمیرگاه ترخیص و به شعبه برسانید.</p>

      <p :if={@ready_by_branch == []} class="mt-3 rounded-lg border border-teal-200 bg-white p-4 text-sm text-zinc-500">
        دستگاه آماده تحویلی برای ترخیص وجود ندارد.
      </p>

      <div :for={{branch, scooters} <- @ready_by_branch} class="mt-3 overflow-hidden rounded-2xl border border-teal-200 bg-white shadow-sm">
        <header class="flex items-center justify-between gap-3 border-b border-teal-100 bg-teal-100/60 px-3 py-2.5">
          <h3 class="text-sm font-extrabold text-teal-900">{if branch, do: branch.name, else: "بدون شعبه"}</h3>
          <span class="rounded-full bg-teal-600 px-2.5 py-1 text-xs font-bold text-white">{length(scooters)} دستگاه</span>
        </header>

        <article :for={scooter <- scooters} class="border-r-4 border-teal-400 border-b border-b-zinc-100 p-3 last:border-b-0">
          <div class="flex items-center gap-2">
            <.icon name="hero-check-badge" class="size-5 shrink-0 text-teal-500" />
            <div class="min-w-0">
              <p class="truncate text-sm font-bold text-zinc-950">پلاک {scooter.plate}</p>
              <p class="truncate text-xs text-zinc-500">{device_type_label(scooter.device_type)}</p>
            </div>
          </div>
          <form method="post" action={~p"/courier/scooters/#{scooter}/deliver"} class="mt-2">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button class="min-h-10 w-full rounded-lg bg-teal-600 text-sm font-black text-white hover:bg-teal-700">ترخیص</button>
          </form>
        </article>
      </div>
    </section>
  </div>
</main>
