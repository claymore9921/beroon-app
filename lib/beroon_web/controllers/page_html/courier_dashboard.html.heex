<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <div class="mx-auto min-h-screen w-full max-w-md bg-stone-50 px-4 pb-24 pt-5">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold">پنل کارپرداز</h1>
        <p class="mt-1 text-sm font-bold text-zinc-500">برون</p>
      </div>
      <.link href={~p"/logout"} method="delete" class="text-sm font-bold text-red-600">خروج</.link>
    </div>

    <.link
      navigate={~p"/courier/transport"}
      class="mt-6 flex items-center gap-4 rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm"
    >
      <div class="flex size-14 shrink-0 items-center justify-center rounded-xl bg-orange-100">
        <.icon name="hero-truck" class="size-8 text-orange-600" />
      </div>
      <div class="min-w-0">
        <h2 class="text-lg font-black text-zinc-950">حمل و نقل دستگاه</h2>
        <p class="mt-1 text-sm text-zinc-500">تحویل‌گیری دستگاه‌های خراب و ترخیص دستگاه‌های آماده تحویل</p>
      </div>
      <.icon name="hero-chevron-left" class="mr-auto size-6 shrink-0 text-zinc-400" />
    </.link>
  </div>
</main>
