<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <section class="mx-auto min-h-screen w-full max-w-md bg-stone-50 px-4 pb-24 pt-5">
<form
      id="admin-report-export-form"
      method="get"
      action={~p"/admin/report-export/download"}
      class="mt-5 grid gap-4 rounded-lg border border-zinc-200 bg-white p-4 shadow-sm"
    >
      <label class="grid gap-2 text-sm font-bold text-zinc-700">
        تاریخ گزارش شبانه
        <input
          id="admin-report-export-date"
          type="text"
          name="date"
          value={Beroon.Calendar.persian_numeric_date(@selected_date)}
          placeholder="۱۴۰۵/۰۵/۰۱" inputmode="numeric" class="input input-bordered min-h-12 w-full"
        />
      </label>

      <p class="text-xs font-bold text-zinc-500">
        تاریخ انتخاب‌شده: {@persian_date}
      </p>

      <div class="rounded-lg border border-zinc-200 bg-zinc-50 p-3 text-xs leading-6 text-zinc-600">
        پایین فایل، جمع کل شعب، جمع تعمیرگاه، در انتظار قطعه، دستگاه‌های امانی، دستگاه‌های سرقتی و
        «جمع کل روزانه ناوگان» نمایش داده می‌شود تا بتوانید عدد کل را روزبه‌روز کنترل کنید.
      </div>

      <button class="btn btn-primary min-h-12 w-full">
        خروجی اکسل روزانه
      </button>

      <.link
        href={~p"/admin/report-export/reference"}
        class="btn btn-neutral min-h-12 w-full"
      >
        آمار مرجع
      </.link>
    </form>
  </section>
</main>
