<Layouts.flash_group flash={@flash} />
<.reporter_layout active="revenue">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black text-[#12283b]">نقدی و کارت به کارت</h1>
      <p class="mt-1 text-sm font-medium text-[#6b7280]">تاریخ: {Beroon.Calendar.persian_date(@report_date)}</p>
    </div>
    <div class="flex items-center gap-3">
      <form method="get" class="flex items-center gap-2">
        <input
          type="text"
          name="date"
          value={Beroon.Calendar.persian_numeric_date(@report_date)}
          placeholder="۱۴۰۵/۰۵/۰۱"
          class="w-36 rounded-lg border border-[#dcd4bf] bg-white px-3 py-2 text-sm font-semibold text-[#12283b] focus:border-[#c9a24b] focus:outline-none"
        />
        <button class="rounded-lg bg-[#12283b] px-4 py-2 text-sm font-black text-white hover:bg-[#0f2942]">نمایش</button>
      </form>
      <.reporter_export_buttons export_json={@export_json} download_url={~p"/reports/revenue/download?date=#{Beroon.Calendar.persian_numeric_date(@report_date)}"} />
    </div>
  </div>

  <section class="mt-6 overflow-x-auto rounded-2xl border border-[#e4ddcd] bg-white shadow-sm">
    <table class="w-full text-right">
      <thead>
        <tr class="border-b border-[#eee7d8] text-xs font-semibold text-[#8a8171]">
          <th class="px-6 py-3">شعبه</th>
          <th class="px-6 py-3">کارت به کارت (تومان)</th>
          <th class="px-6 py-3">نقدی (تومان)</th>
          <th class="px-6 py-3">جمع (تومان)</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={revenue <- @revenue_details} class="border-b border-[#f3efe3] last:border-0 hover:bg-[#faf8f2]">
          <td class="px-6 py-4 font-black text-[#12283b]">{revenue.branch_name}</td>
          <td class="px-6 py-4 font-black text-[#2563a8]">{revenue.card_to_card_amount}</td>
          <td class="px-6 py-4 font-black text-[#2f7a4f]">{revenue.cash_amount}</td>
          <td class="px-6 py-4 font-black text-[#12283b]">{revenue.total_amount}</td>
        </tr>
        <tr :if={@revenue_details == []}>
          <td colspan="4" class="px-6 py-10 text-center text-sm text-[#8a8171]">شعبه‌ی فعالی ثبت نشده است.</td>
        </tr>
      </tbody>
      <tfoot :if={@revenue_details != []}>
        <tr class="border-t-2 border-[#e4ddcd] bg-[#faf8f2]">
          <td class="px-6 py-4 font-black text-[#12283b]">جمع کل</td>
          <td class="px-6 py-4 font-black text-[#2563a8]">{Enum.reduce(@revenue_details, 0, &(&1.card_to_card_amount + &2))}</td>
          <td class="px-6 py-4 font-black text-[#2f7a4f]">{Enum.reduce(@revenue_details, 0, &(&1.cash_amount + &2))}</td>
          <td class="px-6 py-4 font-black text-[#12283b]">{Enum.reduce(@revenue_details, 0, &(&1.total_amount + &2))}</td>
        </tr>
      </tfoot>
    </table>
  </section>
</.reporter_layout>
