<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-950" dir="rtl">
  <section class="mx-auto min-h-screen w-full max-w-3xl bg-stone-50 px-4 pb-24 pt-5">
    <.link navigate={~p"/admin/dinner"} class="text-sm font-bold text-orange-700">بازگشت</.link>
    <div class="mt-2 flex items-center justify-between gap-3">
      <div>
        <h1 class="text-2xl font-black">روزهای مجاز آمار شام</h1>
        <p class="mt-1 text-sm text-zinc-500">برای هر شعبه مشخص کنید چه روزهایی امکان ثبت آمار شام دارد.</p>
      </div>
      <.icon name="hero-calendar-days" class="size-9 text-orange-600" />
    </div>

    <% weekdays = [{6, "شنبه"}, {7, "یکشنبه"}, {1, "دوشنبه"}, {2, "سه‌شنبه"}, {3, "چهارشنبه"}, {4, "پنجشنبه"}, {5, "جمعه"}] %>

    <section class="mt-5 grid gap-3">
      <form
        :for={branch <- @branches}
        method="post"
        action={~p"/admin/dinner/settings/#{branch.id}"}
        class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm"
      >
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <p class="font-black text-zinc-950">{branch.name}</p>
        <div class="mt-3 grid grid-cols-4 gap-2 sm:grid-cols-7">
          <label :for={{value, label} <- weekdays} class="flex flex-col items-center gap-1 rounded-lg border border-zinc-200 p-2 text-xs font-bold">
            <input type="checkbox" name="branch[dinner_open_weekdays][]" value={value} checked={value in branch.dinner_open_weekdays} />
            {label}
          </label>
        </div>
        <button class="btn btn-neutral btn-sm mt-3">ذخیره</button>
      </form>
    </section>
  </section>
</main>
